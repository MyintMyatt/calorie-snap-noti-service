# Application Environment
APP_ENV=aws

# RabbitMQ
RABBITMQ_HOST={{RABBITMQ_HOST}}
RABBITMQ_PORT={{RABBITMQ_PORT}}
RABBITMQ_USER={{RABBITMQ_USER}}
RABBITMQ_PASSWORD={{RABBITMQ_PASSWORD}}

# Mail
MJ_APIKEY_PUBLIC='your key' # api key
MJ_APIKEY_PRIVATE='your key' # secret key
MJ_FROM_EMAIL=your mail
MJ_FROM_NAME=your from name
